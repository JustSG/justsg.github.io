<nav class="navbar">
  <a href="/{{ lang }}/about/" class="navbar__link">{{ translation[lang].about }}</a>
  <a href="/{{ lang }}/projects/" class="navbar__link">{{ translation[lang].projects }}</a>
  <a href="/{{ lang }}/technologies/" class="navbar__link">{{ translation[lang].technologies }}</a>
  <a href="/{{ lang }}/contact/" class="navbar__link">{{ translation[lang].contact }}</a>

  <div class="navbar__divider"></div>

  <button class="navbar__lang" id="lang-toggle">
    <span class="navbar__lang{% if lang == 'en' %}-active{% else %}-inactive{% endif %}">EN</span>
    <span class="navbar__lang-sep">/</span>
    <span class="navbar__lang{% if lang == 'pl' %}-active{% else %}-inactive{% endif %}">PL</span>
  </button>

  <script src="/js/navbar.js"></script>
</nav>